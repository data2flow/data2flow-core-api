<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>net.java21.data2flow</groupId>
    <artifactId>data2flow-core-api</artifactId>
    <version>${revision}</version>
    <name>data2flow-core-api</name>
    <description>회원·조직·권한·기기·공간·소스·스크립트·플로우 정의·규칙·알람·대시보드·조회·운영 설정, 실시간 화면(SSE) (DEV, DSC, SCR, FLW, RUL, TSD, DSH, OPS, IAM)</description>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <!-- 보안 패치(2026-10-03 Trivy): Boot 기본값의 취약 버전을 고친 버전으로 올린다. Boot 다음 패치가 같은 버전 이상을 담으면 지운다
             tomcat 11.0.24 → CVE-2026-65182·65905·68525(CRITICAL), jackson 3.1.5 → CVE-2026-89407·89425·68497·91776·91777(HIGH) -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <data2flow-contracts.version>0.1.0-SNAPSHOT</data2flow-contracts.version>
        <!-- Argon2id(IAM-02.01): Spring Security crypto가 BouncyCastle 구현을 쓴다. Bouncy Castle Licence(MIT 계열, ADR-018 허용) -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- 테스트 SMTP 서버(초대·재설정 메일 검증). Apache-2.0 -->
        <zxing.version>3.5.3</zxing.version>
        <greenmail.version>2.1.14</greenmail.version>
        <!-- 정기 내보내기 SFTP 전달(TSD-07.02). Apache MINA SSHD, Apache-2.0 -->
        <sshd.version>2.20.0</sshd.version>
        <!-- Parquet 내보내기 zstd 압축(TSD-07.02, NFR-04.02). BSD-2-Clause(허용, ADR-018). pipeline과 같은 버전 -->
        <zstd-jni.version>1.5.7-9</zstd-jni.version>
    </properties>

    <!-- data2flow-contracts·data2flow-bom은 GitHub Packages에 있다. 읽기에도 토큰이 필요하다(README 참고) -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/data2flow/data2flow-contracts</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-bom</artifactId>
                <version>${data2flow-contracts.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 플로우 라이브 뷰 WebSocket(API-FLW-40). Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- DB: JdbcClient + Flyway(스키마 data2flow_core). PostgreSQL 배열·inet·jsonb·파티션을 SQL로 직접 다룬다 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 이벤트 아웃박스 릴레이(data2flow.events, ADR-020) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- 실시간 화면(DSH-05.01): Super Stream data2flow.telemetry 소비(그룹 core-live, 비SAC·최신부터).
             버전은 Spring Boot 관리. Apache-2.0 / MPL-2.0 이중 라이선스(ADR-018 허용) -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>stream-client</artifactId>
        </dependency>
        <!-- 초대·재설정·가입 신청 메일(OPS-07.02 메일 서버 설정으로 보냄) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Argon2id 해시(IAM-02.01). spring-security-crypto만 쓰고 Spring Security 필터 체인은 쓰지 않는다(auth.md §7) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- TOTP 비밀값 Base32(IAM-02.05). Apache-2.0 -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <!-- 기기 QR 라벨(DEV-09.04): QR 행렬만 만들고 PDF는 직접 그린다. Apache-2.0(ADR-018 허용) -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- 확정된 과거 집계 조회 캐시(TSD-06.04, BR-TSD-20). s4 Redis를 캐시로만 쓴다(ADR-022). Lettuce MIT/Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>${sshd.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>${zstd-jni.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Boot가 넣는 jakarta.mail-api + angus-mail과 겹친다 -->
                <exclusion>
                    <groupId>org.eclipse.angus</groupId>
                    <artifactId>jakarta.mail</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- *IT는 failsafe로 verify 단계에서 실행(design/testing) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                </executions>
            </plugin>
            <!-- 커버리지 80% 강제. 단위·통합 테스트 결과를 합쳐서 본다 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes><exclude>**/*Application.class</exclude></excludes>
                </configuration>
                <executions>
                    <execution><id>prepare</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>prepare-it</id><goals><goal>prepare-agent-integration</goal></goals></execution>
                    <execution>
                        <id>merge</id><phase>post-integration-test</phase><goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets><fileSet><directory>${project.build.directory}</directory><includes><include>*.exec</include></includes></fileSet></fileSets>
                            <destFile>${project.build.directory}/jacoco-all.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id><phase>verify</phase><goals><goal>report</goal></goals>
                        <configuration><dataFile>${project.build.directory}/jacoco-all.exec</dataFile></configuration>
                    </execution>
                    <execution>
                        <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-all.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
