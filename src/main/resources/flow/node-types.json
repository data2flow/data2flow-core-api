[
  {
    "type": "trigger.telemetry",
    "typeVersion": 1,
    "category": "trigger",
    "name": "텔레메트리",
    "description": "기기·공간·모델 범위의 측정값이 들어오면 시작합니다(FLW-05.01)",
    "icon": "sensor",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "object",
          "title": "대상",
          "description": "deviceIds, spaceId(+relation measures, includeChildren), modelId 중 하나",
          "properties": {
            "deviceIds": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "minItems": 1,
              "maxItems": 1000
            },
            "spaceId": {
              "type": [
                "string",
                "integer"
              ],
              "x-widget": "space"
            },
            "relation": {
              "type": "string",
              "enum": [
                "measures"
              ],
              "default": "measures"
            },
            "includeChildren": {
              "type": "boolean",
              "default": false
            },
            "modelId": {
              "type": [
                "string",
                "integer"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "기기 태그 또는 메시지 meta.tags 값(키:값)"
            }
          }
        },
        "metrics": {
          "type": "array",
          "title": "측정 항목",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 100
        },
        "includeVirtual": {
          "type": "boolean",
          "title": "가상 데이터 포함",
          "default": true
        }
      }
    },
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "target": "RESET",
      "metrics": "RESET",
      "includeVirtual": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "trigger.deviceState",
    "typeVersion": 1,
    "category": "trigger",
    "name": "기기 상태 변화",
    "description": "기기 연결·장비 상태가 바뀌면 실행합니다",
    "icon": "status",
    "configSchema": {
      "type": "object",
      "required": [
        "target",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "x-widget": "target",
          "title": "대상",
          "properties": {
            "deviceIds": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "spaceId": {
              "type": [
                "string",
                "integer"
              ]
            },
            "relation": {
              "type": "string",
              "enum": [
                "measures",
                "controls"
              ]
            },
            "includeChildren": {
              "type": "boolean"
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "STATE_CHANGED"
            ]
          },
          "title": "이벤트"
        },
        "capability": {
          "type": "string",
          "x-widget": "capability",
          "title": "기능"
        }
      }
    },
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "target": "RESET",
      "events": "RESET"
    },
    "permissions": [],
    "defaults": {
      "timeoutMs": 1000
    }
  },
  {
    "type": "trigger.schedule",
    "typeVersion": 1,
    "category": "trigger",
    "name": "일정",
    "description": "정한 시각마다 실행합니다",
    "icon": "clock",
    "configSchema": {
      "type": "object",
      "required": [
        "cron"
      ],
      "additionalProperties": false,
      "properties": {
        "cron": {
          "type": "string",
          "minLength": 9,
          "maxLength": 100,
          "title": "cron(초 분 시 일 월 요일)"
        },
        "timezone": {
          "type": "string",
          "maxLength": 40,
          "title": "시간대"
        }
      }
    },
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "cron": "RESET",
      "timezone": "RESET"
    },
    "permissions": [],
    "defaults": {
      "timeoutMs": 1000
    }
  },
  {
    "type": "trigger.manual",
    "typeVersion": 1,
    "category": "trigger",
    "name": "수동 실행",
    "description": "편집기에서 직접 실행합니다",
    "icon": "play",
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "type": "object",
          "title": "보낼 값"
        }
      }
    },
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {},
    "permissions": [],
    "defaults": {
      "timeoutMs": 1000
    }
  },
  {
    "type": "condition.threshold",
    "typeVersion": 1,
    "category": "condition",
    "name": "임계값",
    "description": "값을 기준과 비교합니다. 지속 시간(for)·해제 기준(clear, 히스테리시스)·연속 횟수(repeat)를 주면 상태가 바뀔 때만 내보냅니다",
    "icon": "gauge",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "title": "측정 항목",
          "description": "payload의 키. 비우면 payload가 숫자일 때 그 값",
          "maxLength": 64
        },
        "op": {
          "type": "string",
          "title": "비교",
          "enum": [
            ">",
            ">=",
            "<",
            "<=",
            "==",
            "!=",
            "outside",
            "inside"
          ],
          "default": ">"
        },
        "value": {
          "type": "number",
          "title": "기준값"
        },
        "range": {
          "type": "array",
          "title": "범위[min,max](outside·inside)",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "for": {
          "type": "string",
          "format": "duration",
          "title": "지속 시간",
          "description": "ISO-8601(PT5M) 또는 5m. 1초~24시간"
        },
        "clear": {
          "type": "number",
          "title": "해제 기준(히스테리시스)"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "title": "연속 횟수",
          "description": "조건이 연속으로 n번 맞아야 발생(BR-RUL-05). 지속 시간과 함께 쓰면 둘 다"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "true",
        "type": "message"
      },
      {
        "name": "false",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "metric": "RESET",
      "op": "RESET",
      "value": "KEEP",
      "range": "KEEP",
      "for": "KEEP",
      "clear": "KEEP",
      "repeat": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "condition.timeWindow",
    "typeVersion": 1,
    "category": "condition",
    "name": "시간 조건",
    "description": "측정 시각이 요일·시각 범위 안이면 true, 밖이면 false(조직 시간대)",
    "icon": "clock",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          }
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "default": "09:00"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "default": "18:00"
        },
        "timezone": {
          "type": "string",
          "default": "Asia/Seoul"
        },
        "invert": {
          "type": "boolean",
          "default": false,
          "description": "범위 밖이면 true(운영 시간 외)"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "true",
        "type": "message"
      },
      {
        "name": "false",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "days": "KEEP",
      "from": "KEEP",
      "to": "KEEP",
      "timezone": "KEEP",
      "invert": "KEEP",
      "spaceSchedule": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "condition.switch",
    "typeVersion": 1,
    "category": "condition",
    "name": "스위치",
    "description": "값이나 속성으로 여러 갈래로 나눕니다. 처음 맞는 케이스 포트 하나로만 나가고, 맞는 것이 없으면 default",
    "icon": "split",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "expression",
        "cases"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "title": "값 경로(JSONPath)",
          "description": "예: $.payload.mode",
          "default": "$.payload"
        },
        "cases": {
          "type": "array",
          "title": "케이스",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "op"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "==",
                  "!=",
                  ">",
                  ">=",
                  "<",
                  "<=",
                  "in",
                  "exists"
                ]
              },
              "value": {}
            }
          }
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "default",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error",
        "dynamic": false
      }
    ],
    "statePolicy": {
      "expression": "KEEP",
      "cases": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "transform.aggregate",
    "typeVersion": 1,
    "category": "transform",
    "name": "집계·창",
    "description": "최근 창(측정 시각 기준) 안의 값을 기기·공간·전체 단위로 평균·최소·최대·합·개수로 묶습니다. 입력마다 1건을 내보냅니다",
    "icon": "sigma",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "window",
        "fn"
      ],
      "properties": {
        "window": {
          "type": "string",
          "format": "duration",
          "title": "창",
          "default": "PT5M"
        },
        "fn": {
          "type": "string",
          "enum": [
            "avg",
            "min",
            "max",
            "sum",
            "count"
          ],
          "default": "avg"
        },
        "groupBy": {
          "type": "string",
          "enum": [
            "device",
            "space",
            "all"
          ],
          "default": "device"
        },
        "metric": {
          "type": "string",
          "description": "비우면 payload의 숫자 항목 전부",
          "maxLength": 64
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "window": "MIGRATE",
      "fn": "KEEP",
      "groupBy": "RESET",
      "metric": "RESET"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "transform.map",
    "typeVersion": 1,
    "category": "transform",
    "name": "필드 매핑",
    "description": "코드 없이 필드 이름 바꾸기(rename), 고르기(pick), 값 넣기(set), 지우기(delete)",
    "icon": "edit",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "rename",
                  "pick",
                  "set",
                  "delete"
                ]
              },
              "path": {
                "type": "string",
                "description": "점 경로(예: payload.temperature). pick은 paths"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "description": "set: 넣을 값, rename: 새 경로"
              }
            }
          }
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "rules": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "transform.js",
    "typeVersion": 1,
    "category": "transform",
    "name": "JavaScript 함수",
    "description": "msg를 받아 가공해 반환합니다. 본문(return …) 또는 function main(msg, ctx)를 씁니다. 출력 포트 1~10개(out1..n), SCR과 같은 샌드박스·제한",
    "icon": "code",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "title": "코드",
          "maxLength": 65536,
          "x-widget": "code",
          "default": "return msg;"
        },
        "outputs": {
          "type": "integer",
          "title": "출력 수",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "scriptRef": {
          "type": "string",
          "description": "스크립트 참조 s-{id}@v{n}(SCR 스크립트의 활성 버전). code 대신",
          "pattern": "^s-\\d+@v\\d+$"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out1",
        "type": "message",
        "dynamic": true
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "code": "KEEP",
      "outputs": "KEEP",
      "scriptRef": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      },
      "timeoutMs": 50
    }
  },
  {
    "type": "flow.delay",
    "typeVersion": 1,
    "category": "flow",
    "name": "지연",
    "description": "지속 타이머(flow_timers)로 지정 시간 뒤에 메시지를 내보냅니다. 엔진이 재시작돼도 이어집니다",
    "icon": "timer",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "duration"
      ],
      "properties": {
        "duration": {
          "type": "string",
          "format": "duration",
          "title": "지연 시간",
          "default": "PT30S",
          "description": "1초~24시간"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "duration": "KEEP"
    },
    "permissions": [],
    "defaults": {
      "retry": {
        "maxAttempts": 0
      }
    }
  },
  {
    "type": "flow.debounce",
    "typeVersion": 1,
    "category": "flow",
    "name": "디바운스",
    "description": "창 안의 마지막 메시지만 넘깁니다",
    "icon": "filter",
    "configSchema": {
      "type": "object",
      "required": [
        "window"
      ],
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "string",
          "format": "duration",
          "pattern": "^P(T(\\d+H)?(\\d+M)?(\\d+S)?)$",
          "x-widget": "duration",
          "title": "창"
        },
        "key": {
          "type": "string",
          "enum": [
            "deviceId",
            "spaceId",
            "none"
          ],
          "title": "키"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "window": "KEEP",
      "key": "RESET"
    },
    "permissions": [],
    "defaults": {
      "timeoutMs": 1000
    }
  },
  {
    "type": "flow.rateLimit",
    "typeVersion": 1,
    "category": "flow",
    "name": "속도 제한",
    "description": "정한 주기에 한 번만 넘깁니다",
    "icon": "speed",
    "configSchema": {
      "type": "object",
      "required": [
        "rate"
      ],
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "string",
          "format": "duration",
          "pattern": "^P(T(\\d+H)?(\\d+M)?(\\d+S)?)$",
          "x-widget": "duration",
          "title": "주기"
        },
        "key": {
          "type": "string",
          "enum": [
            "deviceId",
            "spaceId",
            "none"
          ],
          "title": "키"
        }
      }
    },
    "inputs": [
      {
        "name": "in",
        "type": "message"
      }
    ],
    "outputs": [
      {
        "name": "out",
        "type": "message"
      },
      {
        "name": "error",
        "type": "error"
      }
    ],
    "statePolicy": {
      "rate": "KEEP",
      "key": "RESET"
    },
    "permissions": [],
    "defaults": {
      "timeoutMs": 1000
    }
  },
  {
    "type": "action.control",
    "typeVersion": 1,
    "category": "action",
    "name": "기기 제어",
    "description": "표준 기능 명령을 제어 창구(action)로 보냅니다(아웃박스 → data2flow.actions). 대상은 기기 또는 공간 관계(controls)",
    "icon": "power",
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "target",
        "capability",
