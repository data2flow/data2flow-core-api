   "permissions": [], "defaults": {"timeoutMs": 1000}},
  {"type": "condition.timeWindow", "typeVersion": 1, "category": "condition", "name": "시간대", "description": "요일·시간대 안에 있는지 봅니다", "icon": "calendar",
