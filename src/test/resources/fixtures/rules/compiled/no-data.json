{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "spaceId" : "1",
        "relation" : "measures",
        "includeChildren" : true
      }
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.noData",
    "name" : "noData 30m",
    "config" : {
      "window" : "PT30M"
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MAJOR",
      "title" : "{{device.name}} 무수신",
      "targetBy" : "device"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "timeout",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "resumed",
    "to" : "n-alarm-clear"
  } ]
}
