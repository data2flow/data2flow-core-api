{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "deviceIds" : [ "17" ]
      },
      "metrics" : [ "co2" ]
    }
  }, {
    "id" : "n-time-window",
    "type" : "condition.timeWindow",
    "name" : "시간 조건",
    "config" : {
      "days" : [ "MON", "TUE", "WED", "THU", "FRI" ],
      "from" : "09:00",
      "to" : "18:00"
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.threshold",
    "name" : "co2 > 1000 (5m)",
    "config" : {
      "metric" : "co2",
      "op" : ">",
      "value" : 1000,
      "for" : "PT5M",
      "repeat" : 3
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MAJOR",
      "title" : "반복",
      "targetBy" : "device"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-time-window"
  }, {
    "from" : "n-time-window",
    "port" : "true",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "true",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "false",
    "to" : "n-alarm-clear"
  } ]
}
