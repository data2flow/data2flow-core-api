{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "spaceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "spaceId" : "31",
        "relation" : "measures",
        "includeChildren" : true
      },
      "metrics" : [ "co2" ]
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.composite",
    "name" : "co2 > 1500 OR co2 > 1200",
    "config" : {
      "op" : "OR",
      "items" : [ {
        "kind" : "threshold",
        "metric" : "co2",
        "op" : ">",
        "value" : 1500,
        "aggregate" : "any"
      }, {
        "kind" : "threshold",
        "metric" : "co2",
        "op" : ">",
        "value" : 1200,
        "aggregate" : "spaceAvg"
      } ]
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MAJOR",
      "title" : "공간 CO2",
      "targetBy" : "space"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "space"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "true",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "false",
    "to" : "n-alarm-clear"
  } ]
}
