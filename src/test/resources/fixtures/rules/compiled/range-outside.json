{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "spaceId" : "31",
        "relation" : "measures",
        "includeChildren" : false
      },
      "metrics" : [ "humidity" ]
    }
  }, {
    "id" : "n-trigger-2",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "spaceId" : "32",
        "relation" : "measures",
        "includeChildren" : false
      },
      "metrics" : [ "humidity" ]
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.threshold",
    "name" : "humidity outside [30, 70] (15m)",
    "config" : {
      "metric" : "humidity",
      "op" : "outside",
      "range" : [ 30, 70 ],
      "for" : "PT15M"
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MINOR",
      "title" : "습도 이상",
      "targetBy" : "device"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-trigger-2",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "true",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "false",
    "to" : "n-alarm-clear"
  } ]
}
