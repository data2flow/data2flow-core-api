{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "deviceIds" : [ "17" ]
      },
      "metrics" : [ "temperature" ]
    }
  }, {
    "id" : "n-condition",
    "type" : "detect.anomaly",
    "name" : "anomaly ≥ 3",
    "config" : {
      "metric" : "temperature",
      "method" : "zscore",
      "threshold" : 3
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "WARNING",
      "title" : "이상",
      "targetBy" : "device"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "anomaly",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "normal",
    "to" : "n-alarm-clear"
  } ]
}
