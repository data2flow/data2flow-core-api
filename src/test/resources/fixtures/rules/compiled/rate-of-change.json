{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "deviceIds" : [ "17" ]
      },
      "metrics" : [ "temperature" ]
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.rateOfChange",
    "name" : "temperature Δ3 / 10m",
    "config" : {
      "metric" : "temperature",
      "window" : "PT10M",
      "delta" : 3,
      "direction" : "up"
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MAJOR",
      "title" : "온도 급상승",
      "targetBy" : "device"
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "true",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "false",
    "to" : "n-alarm-clear"
  } ]
}
