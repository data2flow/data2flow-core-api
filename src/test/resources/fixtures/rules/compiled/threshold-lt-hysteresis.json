{
  "schema" : "data2flow.flow-definition/v1",
  "mode" : {
    "concurrency" : "queued",
    "keyBy" : "deviceId",
    "max" : 10
  },
  "nodes" : [ {
    "id" : "n-trigger-1",
    "type" : "trigger.telemetry",
    "name" : "측정값",
    "config" : {
      "target" : {
        "modelId" : "7"
      },
      "metrics" : [ "temperature" ]
    }
  }, {
    "id" : "n-condition",
    "type" : "condition.threshold",
    "name" : "temperature < 18 (10m)",
    "config" : {
      "metric" : "temperature",
      "op" : "<",
      "value" : 18,
      "for" : "PT10M",
      "clear" : 19
    }
  }, {
    "id" : "n-alarm-raise",
    "type" : "action.alarm",
    "name" : "알람 발생",
    "config" : {
      "mode" : "raise",
      "ruleId" : "42",
      "severity" : "MINOR",
      "title" : "저온",
      "targetBy" : "device",
      "lowerIsWorse" : true
    }
  }, {
    "id" : "n-alarm-clear",
    "type" : "action.alarm",
    "name" : "알람 해제",
    "config" : {
      "mode" : "clear",
      "ruleId" : "42",
      "targetBy" : "device"
    }
  } ],
  "wires" : [ {
    "from" : "n-trigger-1",
    "to" : "n-condition"
  }, {
    "from" : "n-condition",
    "port" : "true",
    "to" : "n-alarm-raise"
  }, {
    "from" : "n-condition",
    "port" : "false",
    "to" : "n-alarm-clear"
  } ]
}
